{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "recall-hub",
  "version": "0.1.0",
  "identifier": "com.rohan.recall-hub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Recall Hub",
        "width": 1120,
        "height": 720,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "V:/ALL RECORDINGS/**",
          "V:\\ALL RECORDINGS\\**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}